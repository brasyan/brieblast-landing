VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Briehost API config for site uploads
VITE_BRIEHOST_API_URL=http://localhost:8000
# Optional compatibility aliases (use only if your setup already uses them)
# VITE_BRIEHOST_URL=http://localhost:8000
# VITE_BRIEHOST_BASE_URL=http://localhost:8000

# Optional: if briehost-api requires an API key header
# VITE_BRIEHOST_API_KEY=your-api-key-here
