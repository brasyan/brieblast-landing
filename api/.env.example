# ─────────────────────────────────────────────────────────────────────────────
# Supabase (required)
# ─────────────────────────────────────────────────────────────────────────────
# Project URL from: Supabase → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Found in: Supabase → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Found in: Supabase → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ─────────────────────────────────────────────────────────────────────────────
# Proxmox REST API (required)
# ─────────────────────────────────────────────────────────────────────────────
PROXMOX_HOST=proxmox.example.com
PROXMOX_PORT=8006

# API token created in: Datacenter → Permissions → API Tokens
# Format:  user@realm!token-name
PROXMOX_TOKEN_ID=root@pam!briehost
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Proxmox node name (shown in the left panel of the web UI)
PROXMOX_NODE=pve

# Storage pool that will hold LXC root disks
# Use "local-lvm" for LVM thin-provisioning, "local-zfs" for ZFS, etc.
PROXMOX_STORAGE=local-lvm

# Full path to the LXC template as shown in Proxmox → Storage → CT Templates
PROXMOX_TEMPLATE=local:vztmpl/debian-12-standard_12.2-1_amd64.tar.zst

# Bridge that containers will attach to.  Use a *private* bridge (not vmbr0
# which is typically the public-internet bridge) so containers are isolated.
PROXMOX_BRIDGE=vmbr1

# VMID range reserved for site containers (must not overlap with existing VMs)
PROXMOX_VMID_MIN=200
PROXMOX_VMID_MAX=9999

# Set to "true" if Proxmox uses a CA-signed certificate
PROXMOX_VERIFY_TLS=false

# ─────────────────────────────────────────────────────────────────────────────
# SSH access to Proxmox host (required for pct exec / pct push)
# ─────────────────────────────────────────────────────────────────────────────
# Defaults to PROXMOX_HOST if not set
PROXMOX_SSH_HOST=proxmox.example.com
PROXMOX_SSH_PORT=22
PROXMOX_SSH_USER=root

# Path to the *private* key that the API server uses to SSH into Proxmox.
# Mount it as a Docker secret or a read-only volume.
PROXMOX_SSH_KEY_PATH=/run/secrets/proxmox_ssh_key

# Optional: path to a known_hosts file for strict host-key verification.
# Leave empty to skip verification (insecure – lab environments only).
# PROXMOX_SSH_KNOWN_HOSTS=/run/secrets/proxmox_known_hosts

# ─────────────────────────────────────────────────────────────────────────────
# Container networking
# ─────────────────────────────────────────────────────────────────────────────
# Private /24 subnet base (first three octets).
# Containers get IPs: <base>.10, <base>.11, …
CONTAINER_NETWORK_BASE=10.100.0
CONTAINER_GATEWAY=10.100.0.1
CONTAINER_SUBNET_PREFIX=24

# ─────────────────────────────────────────────────────────────────────────────
# Public domain & reverse proxy
# ─────────────────────────────────────────────────────────────────────────────
# Sites will be published at  https://<short-id>.sites.example.com
BASE_DOMAIN=sites.example.com

# SSH host of the nginx reverse proxy.
# Defaults to PROXMOX_SSH_HOST when the same machine acts as both roles.
# NGINX_PROXY_SSH_HOST=proxy.example.com
NGINX_PROXY_SSH_USER=root

# Directory on the proxy host where per-site vhost configs are dropped
NGINX_SITES_DIR=/etc/nginx/sites-enabled

# Wildcard TLS certificate paths on the proxy host.
# When set, sites are served over HTTPS with the wildcard cert.
# If not set, sites are served over plain HTTP (not suitable for production).
# WILDCARD_CERT_FULLCHAIN=/etc/letsencrypt/live/wildcard/fullchain.pem
# WILDCARD_CERT_KEY=/etc/letsencrypt/live/wildcard/privkey.pem

# ─────────────────────────────────────────────────────────────────────────────
# Local storage
# ─────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/uploads/sites

# ─────────────────────────────────────────────────────────────────────────────
# Rate limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_UPLOADS_PER_HOUR=5

# ─────────────────────────────────────────────────────────────────────────────
# Optional extra security header
# ─────────────────────────────────────────────────────────────────────────────
# When set, every request to the API must include:  x-api-key: <value>
# API_KEY=change-me-to-something-random

# ─────────────────────────────────────────────────────────────────────────────
# Worker / watchdog tuning
# ─────────────────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECONDS=10
WATCHDOG_INTERVAL_SECONDS=60
WORKER_CONCURRENCY=3
